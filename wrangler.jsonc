{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odexos",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Static assets (the built React SPA in ./dist) are served by the Workers
  // Assets runtime. /api/* is routed to the Worker first; everything else is
  // served from ./dist with a single-page-application fallback to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare D1 (SQLite) — the family database.
  // After creating the DB with `wrangler d1 create odexos-db`, paste the
  // returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odexos-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "OdexOS"
  }
}
