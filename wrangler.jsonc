{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odexos",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Static assets (the built React SPA in ./dist) are served by the Workers
  // Assets runtime. /api/* is routed to the Worker first; everything else is
  // served from ./dist with a single-page-application fallback to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare D1 (SQLite) — the family database.
  // The binding stays "DB" (the code uses env.DB); database_id is this
  // account's odexos-db instance.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odexos-db",
      "database_id": "7187977c-45b2-442b-b512-cd72dcd90c3b",
      "migrations_dir": "migrations"
    }
  ],
  // Refresh linked bank balances every 6 hours; send the family digest Monday 07:00 UTC.
  "triggers": {
    "crons": ["0 */6 * * *", "0 7 * * 1"]
  },
  "vars": {
    "APP_NAME": "OdexOS",
    // Bank provider: "mock" (built-in demo) or "truelayer". Leave unset to
    // auto-detect — TrueLayer is used when its credentials are configured,
    // otherwise the mock provider. TrueLayer environment: "sandbox" | "live".
    "TRUELAYER_ENV": "live"
    // Secrets (set with `wrangler secret put <NAME>`), never commit these:
    //   TRUELAYER_CLIENT_ID, TRUELAYER_CLIENT_SECRET, ENCRYPTION_KEY
    // Optional: TRUELAYER_REDIRECT_URI, APP_URL, BANK_PROVIDER
  }
}
